import {useEffect,useState} from 'react';
import {workspace} from '../project/workspace';
import {analyzeGeometry,type Suggestion} from '../recognition/geometry';
import type {DrawEngine} from '../engine/DrawEngine';
import {GestureButton} from './GestureButton';
import {useInteractive} from '../interaction/useInteractive';
import {appMode} from '../app/AppMode';
import {getRecognitionProvider} from '../recognition/provider';
export function RecognitionSuggestion({engine}:{engine:DrawEngine}){
 const [candidate,setCandidate]=useState<{id:string;suggestion?:Suggestion;text?:string}|null>(null);const zone=useInteractive({id:'recognition-zone'});
 useEffect(()=>{let timer:ReturnType<typeof setTimeout>,fade:ReturnType<typeof setTimeout>,abort=new AbortController();const off=engine.onHistoryChange(()=>{abort.abort();abort=new AbortController();clearTimeout(timer);clearTimeout(fade);setCandidate(null);timer=setTimeout(()=>{const signal=abort.signal;const analyze=async()=>{if(engine.activeStroke||appMode.getSnapshot().mode!=='CANVAS_DRAW'||signal.aborted)return;const o=workspace.project.objects.filter(o=>o.type==='stroke2d'&&!o.locked).at(-1);if(!o?.stroke||o.recognition)return;const suggestion=analyzeGeometry(o.stroke.segments.flat());let text:string|undefined;if(!suggestion){try{const result=await getRecognitionProvider()?.recognize([o.stroke],signal);if(result&&result.confidence>=.8)text=result.text.slice(0,80);}catch{/* A failed optional provider never interrupts ink. */}}if(signal.aborted||engine.activeStroke)return;if(suggestion||text){setCandidate({id:o.id,suggestion:suggestion??undefined,text});fade=setTimeout(()=>setCandidate(null),6500);}};if('requestIdleCallback' in window)window.requestIdleCallback(()=>void analyze(),{timeout:300});else void analyze();},850);});return()=>{off();abort.abort();clearTimeout(timer);clearTimeout(fade);};},[engine]);
 useEffect(()=>engine.onCursor(c=>{if(c.drawing)setCandidate(null);}),[engine]);
 if(!candidate)return null;
 const object=workspace.project.objects.find(o=>o.id===candidate.id),point=object?.stroke?.segments.at(-1)?.at(-1),screen=point?engine.toScreenPoint(point):null;
 return <div ref={zone.ref as React.RefObject<HTMLDivElement>} className="ad-recognition ad-glass" style={screen?{left:Math.min(innerWidth-190,Math.max(190,screen.x)),top:Math.min(innerHeight-180,Math.max(100,screen.y+48)),bottom:'auto'}:undefined}><GestureButton id="recognition-confirm" label={candidate.suggestion?.label??`识别为 ${candidate.text}`} onActivate={()=>{const o=workspace.project.objects.find(o=>o.id===candidate.id);if(o?.stroke&&!o.locked)workspace.patch(o.id,candidate.suggestion?{recognition:'geometry',stroke:{...o.stroke,segments:[candidate.suggestion.points]}}:{recognition:'text',text:candidate.text},'识别转换');setCandidate(null);}}/></div>;
}
