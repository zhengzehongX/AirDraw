import { chromium } from 'playwright-core';
import { installGestureDriver, enterApp } from './gestureDriver.mjs';

/**
 * READ-ONLY verification for P10-A: does a toy actually answer the hand once it is
 * on screen, and is anything else still eating the pinch?
 *
 * Nothing here asserts yet — it records the numbers the fix has to move.
 */
const APP = process.env.APP_URL ?? 'http://localhost:5174/?simulate=1';
const browser = await chromium.launch({
  executablePath: process.env.CHROME_PATH ?? 'C:/Program Files/Google/Chrome/Application/chrome.exe',
  headless: true,
  args: ['--enable-unsafe-swiftshader', '--use-angle=swiftshader'],
});
const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });
const pageErrors = [], consoleErrors = [];
page.on('pageerror', (e) => pageErrors.push(String(e?.message || e).slice(0, 500)));
page.on('console', (m) => { if (m.type() === 'error') consoleErrors.push(m.text().slice(0, 800)); });
const out = {};
const say = (k, v) => { out[k] = v; console.log('###', k, JSON.stringify(v, null, 1)); };

await page.addInitScript(() => {
  localStorage.setItem('airdraw-preferences-v1', JSON.stringify({ schema: 1, tutorialDone: true, helloSeen: true }));
  localStorage.setItem('airdraw-pinch-calibration', JSON.stringify({ contact: .30, release: .37, projection: .30, z: .16, calibratedAt: '2026-10-05T00:00:00Z' }));
});
await page.goto(APP);
await enterApp(page, { target: 'PLAYLAB' });
await page.evaluate(installGestureDriver);
await page.waitForSelector('[data-testid="lab-hub"]', { timeout: 10000 });

// 1 — the hub is chrome-free: only lab regions may take a pinch.
function liveRegionReport() {
  const mgr = window.__airdrawInteraction;
  const owner = mgr.screenOwner;
  const live = [];
  for (const [id, region] of mgr.regions) {
    const scope = region?.scope;
    const inScope = owner === 'toy' ? scope === 'toy' : !scope || scope === 'global' || scope === mgr.scope;
    if (!inScope) continue;
    const rect = mgr.rects.get(id);
    live.push({ id, scope: scope ?? null, activates: !!(region?.onActivate || region?.onDrag), rect: rect ? { l: Math.round(rect.left), t: Math.round(rect.top), r: Math.round(rect.right), b: Math.round(rect.bottom) } : null });
  }
  return { owner, scope: mgr.scope, count: live.length, live: live.sort((a, b) => a.id.localeCompare(b.id)) };
}
say('hub_regions', await page.evaluate(liveRegionReport));

// 2 — enter the orb and re-read the region list.
await page.evaluate(() => window.__airdrawLab.request('orb'));
await page.evaluate(() => window.__gesture.push(0.5, 0.5, 'open'));
await page.waitForFunction(() => ['waiting', 'ready'].includes(window.__airdrawLab.state.status), null, { timeout: 10000 });
say('active_regions', await page.evaluate(liveRegionReport));
say('centre_blocked', await page.evaluate(() => {
  const mgr = window.__airdrawInteraction;
  return { centre: mgr.containsPoint({ x: innerWidth / 2, y: innerHeight / 2, z: 0 }), leftDock: mgr.containsPoint({ x: 76, y: 400, z: 0 }), rightPopover: mgr.containsPoint({ x: 1300, y: 450, z: 0 }), corner: mgr.containsPoint({ x: 1400, y: 40, z: 0 }) };
}));

// 3 — drive a hand at the orb and watch whether the toy actually reacts.
const grab = await page.evaluate(async () => {
  const sleep = (t) => new Promise((r) => setTimeout(r, t));
  const lab = window.__airdrawLab, g = window.__gesture;
  const toy = lab.toy;
  if (!toy) return { error: 'no toy instance' };
  const body = toy.bodies?.[0];
  if (!body) return { error: 'toy has no bodies[0]', keys: Object.keys(toy) };

  const readCharge = () => {
    let uniform = null;
    lab.group?.traverse((o) => {
      const u = o.material?.uniforms;
      if (u?.uCharge !== undefined) uniform = u.uCharge.value;
    });
    return { uniform: uniform === null ? null : +Number(uniform).toFixed(3), bodyCharge: +Number(body.charge ?? -1).toFixed(3) };
  };
  const frameOf = (b) => ({ u: b.position.x / 16 + 0.5, v: 0.5 - b.position.y / 9 });

  const samples = [];
  let lastPinch = null, frames = 0, gestures = [];
  const originalGesture = toy.onGesture?.bind(toy);
  if (toy.onGesture) toy.onGesture = (event, frame, ctx) => { gestures.push(event); lastPinch = frame.primary?.pinchPoint ?? null; frames += 1; return originalGesture(event, frame, ctx); };

  // Chase the orb: it moves, so aim again each step instead of firing once.
  const aim = async (mode, ms) => {
    const t0 = performance.now();
    while (performance.now() - t0 < ms) {
      const p = frameOf(body);
      g.push(Math.min(0.94, Math.max(0.06, p.u)), Math.min(0.9, Math.max(0.1, p.v)), mode);
      await sleep(33);
    }
  };

  await aim('open', 900);
  const afterOpen = { charge: readCharge(), pos: [ +body.position.x.toFixed(2), +body.position.y.toFixed(2) ], grabbed: body.grabbed, gestures: gestures.slice() };
  gestures = [];
  await aim('pinch', 1400);
  const during = { charge: readCharge(), grabbed: body.grabbed, pos: [ +body.position.x.toFixed(2), +body.position.y.toFixed(2) ], pinchPoint: lastPinch, distance: lastPinch ? +Math.hypot(frameOf(body).u - lastPinch.x, frameOf(body).v - lastPinch.y).toFixed(3) : null, events: gestures.slice() };
  gestures = [];
  await aim('open', 700);
  const afterRelease = { charge: readCharge(), grabbed: body.grabbed, speed: +Math.hypot(body.velocity.x, body.velocity.y).toFixed(2), events: gestures.slice() };

  if (toy.onGesture && originalGesture) toy.onGesture = originalGesture;
  return { radius: window.__airdrawLab.toy?.constructor?.RADIUS ?? null, afterOpen, during, afterRelease };
});
say('orb_grab_sequence', grab);

// 4 — the five states, in order, with their real reasons.
const states = await page.evaluate(async () => {
  const sleep = (t) => new Promise((r) => setTimeout(r, t));
  const lab = window.__airdrawLab, g = window.__gesture;
  const seen = new Set();
  const t0 = performance.now();
  while (performance.now() - t0 < 2600) {
    seen.add(`${lab.state.status}:${lab.state.detail ?? ''}`);
    await sleep(60);
  }
  g.push(0.5, 0.45, 'open');
  await sleep(400);
  const withHand = { status: lab.state.status, detail: lab.state.detail };
  // Drop the hand entirely: the toy must say so rather than look broken.
  window.__airdraw.handleResult({ hands: [], timestamp: performance.now(), inferenceMs: 0.4, videoWidth: 1280, videoHeight: 720, source: 'synthetic' });
  await sleep(700);
  const withoutHand = { status: lab.state.status, detail: lab.state.detail };
  const chrome = document.querySelector('[data-testid="lab-chrome"]');
  return { seen: [...seen], withHand, withoutHand, chromeStatus: chrome?.getAttribute('data-status') ?? null, statusText: chrome?.querySelector('[data-testid="lab-status"]')?.textContent ?? null };
});
say('lab_states', states);

// 5 — every toy: does a hand change anything observable on screen?
const perToy = await page.evaluate(async () => {
  const sleep = (t) => new Promise((r) => setTimeout(r, t));
  const lab = window.__airdrawLab, g = window.__gesture, eng = window.__airdraw;
  const ids = ['orb', 'galaxy', 'fluid', 'ocean', 'fireworks'];
  const rows = [];
  for (const id of ids) {
    lab.request(id);
    for (let i = 0; i < 60 && lab.state.phase !== 'ACTIVE'; i += 1) await sleep(50);
    for (let i = 0; i < 60 && !lab.toy; i += 1) await sleep(50);
    const toy = lab.toy;
    if (!toy) { rows.push({ id, error: 'did not mount', state: lab.state.error }); continue; }
    const events = [];
    const original = toy.onGesture?.bind(toy);
    if (toy.onGesture) toy.onGesture = (e, f, c) => { events.push(e); return original?.(e, f, c); };
    const before = (() => { let n = 0; lab.group.traverse(() => n += 1); return n; })();
    // sweep the hand through the volume twice, then pinch at three heights
    for (let k = 0; k < 2; k += 1) {
      for (let u = 0.2; u <= 0.8; u += 0.1) { g.push(u, 0.5, 'open'); await sleep(50); }
    }
    for (const v of [0.35, 0.5, 0.65]) {
      for (let k = 0; k < 8; k += 1) { g.push(0.5, v, 'pinch'); await sleep(40); }
      for (let k = 0; k < 5; k += 1) { g.push(0.5, v, 'open'); await sleep(40); }
    }
    const after = (() => { let n = 0; lab.group.traverse(() => n += 1); return n; })();
    const gl = window.__airdrawThree?.gl;
    rows.push({ id, nodesBefore: before, nodesAfter: after, events: [...new Set(events)].sort(), eventCount: events.length, interactive: lab.state.interactive, status: lab.state.status, geometries: gl?.info.memory.geometries ?? null, textures: gl?.info.memory.textures ?? null, error: lab.state.error });
    if (toy.onGesture && original) toy.onGesture = original;
    await sleep(120);
  }
  return rows;
});
say('perToy', perToy);

// 5b — a failed mount must say so, offer retry, and actually recover.
const failure = await page.evaluate(async () => {
  const sleep = (t) => new Promise((r) => setTimeout(r, t));
  const lab = window.__airdrawLab;
  const g = window.__gesture;
  lab.error = '探针注入：测试加载失败态';
  await sleep(200);
  const failed = { status: lab.state.status, detail: lab.state.detail, chrome: document.querySelector('[data-status]')?.getAttribute('data-status') };
  const retry = document.querySelector('[data-gesture-id="lab-retry"]');
  const retryVisible = !!retry && getComputedStyle(retry).display !== 'none';
  retry?.click();
  for (let i = 0; i < 60 && lab.state.status === 'failed'; i += 1) { g.push(0.5, 0.5, 'open'); await sleep(50); }
  await sleep(300);
  return { failed, retryVisible, recovered: { status: lab.state.status, error: lab.state.error, hasToy: !!lab.toy } };
});
say('failed_and_retry', failure);

// 5c — leaving by hand must work: 返回 is the only target inside a toy.
const exitByHand = await page.evaluate(async () => {
  const sleep = (t) => new Promise((r) => setTimeout(r, t));
  const lab = window.__airdrawLab, g = window.__gesture;
  lab.request('orb');
  for (let i = 0; i < 60 && lab.state.status === 'loading'; i += 1) { g.push(0.5, 0.5, 'open'); await sleep(50); }
  for (let i = 0; i < 20; i += 1) { g.push(0.5, 0.5, 'open'); await sleep(33); }
  const result = await g.click('[data-gesture-id="lab-back"]');
  for (let i = 0; i < 40 && lab.state.phase !== 'HUB'; i += 1) { g.push(0.5, 0.5, 'open'); await sleep(50); }
  return { clickResult: result, phase: lab.state.phase, owner: window.__airdrawInteraction.screenOwner, activations: window.__airdrawInteraction.activationCount, hubVisible: !!document.querySelector('[data-testid="lab-hub"]') };
});
say('exit_by_hand', exitByHand);

// 6 — leaving must hand the screen back and not restart anything.
const after = await page.evaluate(async () => {
  const sleep = (t) => new Promise((r) => setTimeout(r, t));
  const lab = window.__airdrawLab;
  const mgr = window.__airdrawInteraction;
  lab.back();
  await sleep(1200);
  const cam = window.__airdrawCamera?.()?.diagnostics ?? null;
  return { owner: mgr.screenOwner, scope: mgr.scope, phase: lab.state.phase, status: lab.state.status, toy: !!lab.toy, camDiagnostics: cam, nodes: (() => { let n = 0; lab.group.traverse(() => n += 1); return n; })(), gl: { geometries: window.__airdrawThree?.gl?.info.memory.geometries, textures: window.__airdrawThree?.gl?.info.memory.textures }, workers: performance.getEntriesByType('measure').filter((e) => /worker/i.test(e.name)).length };
});
say('after_back', after);

say('pageErrors', pageErrors);
say('consoleErrors', consoleErrors.slice(0, 8));

/**
 * The measurements above become the suite's assertions, so a regression in any of
 * them — a menu stealing the pinch again, a toy that mounts but never answers —
 * fails the run instead of quietly printing numbers.
 */
const checks = [];
const assert = (name, pass, detail) => { checks.push({ name, pass, detail }); console.log(`${pass ? 'PASS' : 'FAIL'} ${name}${detail ? ` — ${String(detail).slice(0, 160)}` : ''}`); };
const ids = (list) => list.map((r) => r.id);
/**
 * What must stay off the toy rail: the drawing tool row, the surface dock, and the
 * mode segment. The workspace bar's own globals (gallery, guide, settings, theme,
 * camera, voice) belong to every workspace screen and are not competition.
 */
const DRAWING_AFFORDANCE = /^(surface-|canvas-|color-|paper-|mode-|dock-(color|material|size|undo|redo|erase|clear|view|center|save|more)$)/;
assert('hub exposes only lab and global affordances', !ids(out.hub_regions.live).some((id) => DRAWING_AFFORDANCE.test(id)), ids(out.hub_regions.live).join(','));
/**
 * While a toy plays, the only live regions are the toy's own two permanent doors:
 * 玩具大厅 (`lab-back`) and 返回画布 (`lab-canvas`). Anything else — a colour
 * swatch, the theme switch — would steal the pinch and the toy would never know.
 */
const TOY_CHROME = 'lab-back,lab-canvas';
assert('a playing toy owns every pinch', out.active_regions.owner === 'toy' && ids(out.active_regions.live).join(',') === TOY_CHROME, `${out.active_regions.owner}: ${ids(out.active_regions.live).join(',')}`);
assert('the toy area is not covered by invisible hit boxes', !out.centre_blocked.centre && !out.centre_blocked.leftDock && !out.centre_blocked.rightPopover && !out.centre_blocked.corner, JSON.stringify(out.centre_blocked));
assert('a pinch on the orb grabs and charges it', out.orb_grab_sequence.during?.grabbed === 'primary' && out.orb_grab_sequence.during?.charge?.bodyCharge > 0.3, JSON.stringify(out.orb_grab_sequence.during));
assert('the uniform follows the body charge', out.orb_grab_sequence.during?.charge?.uniform === out.orb_grab_sequence.during?.charge?.bodyCharge, JSON.stringify(out.orb_grab_sequence.during?.charge));
assert('releasing throws the orb', out.orb_grab_sequence.afterRelease?.grabbed === 'none' && out.orb_grab_sequence.afterRelease?.speed > 0.5, JSON.stringify(out.orb_grab_sequence.afterRelease));
assert('the five states are reachable with real reasons', ['ready', 'waiting'].every((s) => out.lab_states.seen.some((row) => row.startsWith(`${s}:`))), out.lab_states.seen.join(' | '));
assert('hand loss pauses rather than pretending', out.lab_states.withoutHand?.status === 'paused', JSON.stringify(out.lab_states.withoutHand));
assert('every toy mounts, answers and reports no error', out.perToy.length === 5 && out.perToy.every((row) => row.status === 'ready' && row.error === null && row.nodesBefore > 2 && row.geometries > 0 && row.eventCount > 0), out.perToy.map((r) => `${r.id}:${r.status}/${r.eventCount}`).join(' '));
assert('a failed mount explains itself and recovers on retry', out.failed_and_retry.failed?.status === 'failed' && out.failed_and_retry.retryVisible && out.failed_and_retry.recovered?.status !== 'failed', JSON.stringify(out.failed_and_retry));
assert('leaving by hand returns to the rail', out.exit_by_hand.phase === 'HUB' && out.exit_by_hand.owner === 'ui' && out.exit_by_hand.hubVisible, JSON.stringify(out.exit_by_hand));
assert('exiting releases the toy without a second canvas', out.after_back.toy === false && out.after_back.nodes === 2 && out.after_back.gl.geometries <= 2, JSON.stringify(out.after_back));
assert('no runtime or console exceptions', pageErrors.length === 0 && consoleErrors.length === 0, `${pageErrors.length}/${consoleErrors.length}`);

const fs = await import('node:fs');
fs.writeFileSync('docs/verification/phase10-toys.json', JSON.stringify({ at: new Date().toISOString(), checks, measurements: out }, null, 1));
const failed = checks.filter((c) => !c.pass).length;
console.log(`${checks.length - failed}/${checks.length} checks passed`);
if (failed) process.exitCode = 1;
await browser.close();
